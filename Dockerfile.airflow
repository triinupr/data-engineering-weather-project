FROM apache/airflow:2.10.5-python3.12
COPY requirements.txt /requirements.txt
# Retain the base Airflow version when installing project dependencies.
RUN pip install --no-cache-dir "apache-airflow==2.10.5" -r /requirements.txt "psycopg2-binary==2.9.10"
# dbt's dependencies are isolated from Airflow's SQLAlchemy/Jinja dependencies.
RUN python -m venv /opt/airflow/dbt-venv && \
    PIP_USER=false /opt/airflow/dbt-venv/bin/pip install --no-cache-dir "dbt-core==1.10.15" "dbt-postgres==1.9.1"
